  "bodyHtml": "<style>\r\n    /* Scoped CSS to prevent interfering with your Drupal theme */\r\n    .ashg-events-portal {\r\n        font-family: Arial, sans-serif;\r\n        max-width: 1200px;\r\n        margin: 0 auto;\r\n        padding: 20px 0;\r\n        text-align: center;\r\n    }\r\n\r\n    .ashg-events-portal h1 {\r\n        font-size: 2.5rem;\r\n        color: #0d2b4d;\r\n        margin-bottom: 40px;\r\n    }\r\n\r\n    /* Grid for the three photo links */\r\n    .ashg-photo-grid {\r\n        display: grid;\r\n        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\r\n        gap: 30px;\r\n        margin-bottom: 60px;\r\n    }\r\n\r\n    .ashg-card {\r\n        display: block;\r\n        text-decoration: none;\r\n        background: #f9f9f9;\r\n        border-radius: 8px;\r\n        overflow: hidden;\r\n        box-shadow: 0 4px 6px rgba(0,0,0,0.1);\r\n        transition: transform 0.3s ease, box-shadow 0.3s ease;\r\n        color: #333;\r\n    }\r\n\r\n    .ashg-card:hover {\r\n        transform: translateY(-5px);\r\n        box-shadow: 0 8px 15px rgba(0,0,0,0.15);\r\n        text-decoration: none;\r\n    }\r\n\r\n    .ashg-card img {\r\n        width: 100%;\r\n        height: 250px;\r\n        object-fit: cover;\r\n        display: block;\r\n    }\r\n\r\n    .ashg-card h2 {\r\n        font-size: 1.5rem;\r\n        margin: 20px 0;\r\n        color: #005bb5;\r\n    }\r\n\r\n    /* Countdown Timer Styles */\r\n    .ashg-countdown-wrapper {\r\n        background: #0d2b4d;\r\n        color: white;\r\n        padding: 40px 20px;\r\n        border-radius: 8px;\r\n    }\r\n\r\n    .ashg-countdown-wrapper h3 {\r\n        margin-top: 0;\r\n        font-size: 1.8rem;\r\n        margin-bottom: 20px;\r\n        color: white;\r\n    }\r\n\r\n    .ashg-timer {\r\n        display: flex;\r\n        justify-content: center;\r\n        gap: 20px;\r\n        flex-wrap: wrap;\r\n    }\r\n\r\n    .ashg-time-box {\r\n        background: rgba(255, 255, 255, 0.1);\